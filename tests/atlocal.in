CC="@CC@"
# MIGRATION (C->Python): SHREXT is the NATIVE shared-object extension used by
# the test sources' raw "${CC} ${SHROPT} -o dump.${SHREXT} dump.c" commands,
# which build a C helper (dump.c) the COBOL programs CALL.  It must therefore
# stay a native extension - NOT the Python module extension COB_MODULE_EXT
# (".pyz").  The original tree set SHREXT from the platform shared-lib ext;
# under the Python backend COB_MODULE_EXT was repurposed to ".pyz", so SHREXT is
# pinned here to the native Linux ext "so" (yielding "dump.so").  libcob_py.call
# resolves such a CALL by dlopen'ing the ELF object via ctypes.
SHREXT="so"
SHROPT="@COB_SHARED_OPT@ @COB_PIC_FLAGS@ @CFLAGS@ @LDFLAGS@"
COB_BIGENDIAN="@COB_BIGENDIAN@"
# MIGRATION (C->Python): configure.ac no longer computes COB_HAS_ISAM via the
# dropped Berkeley DB / C-ISAM detection, but the Python backend DOES provide
# indexed-file I/O - libcob_py.fileio implements ORGANIZATION INDEXED over
# dbm/sqlite3 (AAP 0.6.3).  COB_HAS_ISAM is therefore exported as "yes" further
# below so indexed-file tests that probe it RUN (and pass) instead of skipping:
# the capability genuinely exists (verified: OPEN OUTPUT/CLOSE, WRITE keyed
# records, READ RANDOM by key, and READ NEXT in key order all work), so leaving
# it unset would understate coverage rather than reflect a missing feature.
# PATH no longer includes libcob/.libs - the native libcob.so is not built.
PATH="${abs_top_builddir}/cobc:${abs_top_builddir}/bin:${PATH}"
COBC="${abs_top_builddir}/cobc/cobc"
COBCRUN="${abs_top_builddir}/bin/cobcrun"

TEMPLATE="${abs_srcdir}/data-rep.src"

FLAGS="-std=cobol2002 -debug -Wall ${COBOL_FLAGS}"
COMPILE="${COBC} -x ${FLAGS}"
COMPILE_ONLY="${COBC} -fsyntax-only ${FLAGS}"
COMPILE_MODULE="${COBC} -m ${FLAGS}"

# MIGRATION (C->Python): the Python backend needs the interpreter and the
# libcob_py runtime location, NOT C compiler/linker flags or the native libcob.so
# search paths. COB_PYTHON is the Python 3.11+ backend (AC_SUBST'd by
# configure.ac); COB_LIBPY_DIR points cobc at the in-tree runtime package so that
# "cobc -m"/"cobc -x" bundle a self-contained .pyz during the build and the test
# suite - and the extras/ CBL_OC_DUMP build, which sources this file - without
# needing "make install" or a PYTHONPATH crutch (QA Issue 2). The libcob_py
# sources are pure Python in the source tree, so srcdir is correct for VPATH.
export COB_PYTHON="@COB_PYTHON@"
export COB_LIBPY_DIR="${abs_top_srcdir}/libcob_py"
export COB_CONFIG_DIR="${abs_top_srcdir}/config"
export COB_COPY_DIR="${abs_top_srcdir}/copy"
# MIGRATION (C->Python): indexed-file I/O is provided by libcob_py.fileio via the
# Python standard library (dbm/sqlite3), so the runtime DOES have ISAM-equivalent
# capability even though the native C-ISAM/Berkeley DB libraries are gone.  Export
# COB_HAS_ISAM=yes so the COBOL indexed-file tests (e.g. "First READ on empty
# SEQUENTIAL INDEXED file") exercise the real indexed path and pass.
export COB_HAS_ISAM="yes"
# MIGRATION (C->Python): removed stale C-runtime exports COB_CFLAGS / COB_LDFLAGS /
# COB_LIBS (-lcob) and the native shared-library search paths LD_LIBRARY_PATH /
# DYLD_LIBRARY_PATH / SHLIB_PATH / LIBPATH (all pointed at libcob/.libs) -
# libcob.so is no longer built and the runtime is pure Python (libcob_py).
# (COB_HAS_ISAM is intentionally retained and exported above as "yes" because the
# Python fileio backend provides indexed-file I/O - see the note near its export.)

